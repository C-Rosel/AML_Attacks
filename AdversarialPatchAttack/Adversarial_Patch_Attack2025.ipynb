    {
      "cell_type": "markdown",
      "source": [
        "# Defining Helper functions:"
      ],
      "metadata": {
        "id": "Mu10B040Xw60"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "Labels and prediction boxes (to be used in object detection)"
      ],
      "metadata": {
        "id": "5GC9aZv4esJa"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "#list of all potential items in the image classifier:\n",
        "INSTANCE_CATEGORY_NAMES = ['person', 'bicycle', 'car', 'motorcycle', 'airplane', 'bus', 'train', 'truck', 'boat', 'traffic light',\n",
        "        'fire hydrant', 'stop sign', 'parking meter', 'bench', 'bird', 'cat', 'dog', 'horse', 'sheep', 'cow',\n",
        "        'elephant', 'bear', 'zebra', 'giraffe', 'backpack', 'umbrella', 'handbag', 'tie', 'suitcase', 'frisbee',\n",
        "        'skis', 'snowboard', 'sports ball', 'kite', 'baseball bat', 'baseball glove', 'skateboard', 'surfboard',\n",
        "        'tennis racket', 'bottle', 'wine glass', 'cup', 'fork', 'knife', 'spoon', 'bowl', 'banana', 'apple',\n",
        "        'sandwich', 'orange', 'broccoli', 'carrot', 'hot dog', 'pizza', 'donut', 'cake', 'chair', 'couch',\n",
        "        'potted plant', 'bed', 'dining table', 'toilet', 'tv', 'laptop', 'mouse', 'remote', 'keyboard',\n",
        "        'cell phone', 'microwave', 'oven', 'toaster', 'sink', 'refrigerator', 'book', 'clock', 'vase', 'scissors',\n",
        "        'teddy bear', 'hair drier', 'toothbrush']\n",
        "\n",
        "#parameters: raw Yolo prediction data, confidence metric threshold.\n",
        "def extract_predictions(predictions_, conf_thresh):\n",
        "    predictions_class = [INSTANCE_CATEGORY_NAMES[i] for i in list(predictions_[\"labels\"])]\n",
        "    if len(predictions_class) < 1:\n",
        "        return [], [], []\n",
        "\n",
        "    # Get the predicted bounding boxes\n",
        "    # This identifies the location of the object within the image.\n",
        "    predictions_boxes = [[(i[0], i[1]), (i[2], i[3])] for i in list(predictions_[\"boxes\"])]\n",
        "\n",
        "    # Get the predicted confidence score\n",
        "    # this is the liklihood of the image containing one of the above-defined categeories.\n",
        "    predictions_score = list(predictions_[\"scores\"])\n",
        "\n",
        "    # Get a list of index with score greater than threshold\n",
        "    threshold = conf_thresh\n",
        "    predictions_t = [predictions_score.index(x) for x in predictions_score if x > threshold]\n",
        "    if len(predictions_t) > 0:\n",
        "        predictions_t = predictions_t\n",
        "    else:\n",
        "        return [], [], []         # else no predictions exceed threshold\n",
        "\n",
        "    # predictions in score order:\n",
        "    predictions_boxes = [predictions_boxes[i] for i in predictions_t]\n",
        "    predictions_class = [predictions_class[i] for i in predictions_t]\n",
        "    predictions_scores = [predictions_score[i] for i in predictions_t]\n",
        "    return predictions_class, predictions_boxes, predictions_scores\n",
        "\n",
        "#use the grid to show exactly where the object(s) is detected in the image\n",
        "def plot_image_with_boxes(img, boxes, pred_cls, title):\n",
        "    text_size = 1\n",
        "    text_th = 2\n",
        "    rect_th = 2\n",
        "\n",
        "    # box appearance and application:\n",
        "    for i in range(len(boxes)):\n",
        "        cv2.rectangle(img, (int(boxes[i][0][0]), int(boxes[i][0][1])), (int(boxes[i][1][0]), int(boxes[i][1][1])),\n",
        "                      color=(0, 255, 0), thickness=rect_th)\n",
        "\n",
        "        cv2.putText(img, pred_cls[i], (int(boxes[i][0][0]), int(boxes[i][0][1])), cv2.FONT_HERSHEY_SIMPLEX, text_size,\n",
        "                    (0, 255, 0), thickness=text_th)\n",
        "\n",
        "    plt.figure()\n",
        "    plt.axis(\"off\")\n",
        "    plt.title(title)\n",
        "    plt.imshow(img.astype(np.uint8), interpolation=\"nearest\")\n",
        "    plt.show()"
      ],
      "metadata": {
        "id": "nUXYqMLb9XFa"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Model Definition:"
      ],
      "metadata": {
        "id": "L0w5fjt2-u0v"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import yolov5\n",
        "from yolov5.utils.loss import ComputeLoss\n",
        "import torch\n",
        "\n",
        "class Yolo(torch.nn.Module):\n",
        "    def __init__(self, model):\n",
        "        super().__init__()\n",
        "        self.model = model\n",
        "        self.model.hyp = {'box': 0.05,\n",
        "                          'obj': 1.0,\n",
        "                          'cls': 0.5,\n",
        "                          'anchor_t': 4.0,\n",
        "                          'cls_pw': 1.0,\n",
        "                          'obj_pw': 1.0,\n",
        "                          'fl_gamma': 0.0\n",
        "                          }\n",
        "        self.compute_loss = ComputeLoss(self.model.model.model)  #loss function\n",
        "\n",
        "    #how the model handles input data.\n",
        "    def forward(self, x, targets=None):\n",
        "        if self.training:\n",
        "            outputs = self.model.model.model(x)\n",
        "            loss, loss_items = self.compute_loss(outputs, targets)\n",
        "            loss_components_dict = {\"loss_total\": loss}\n",
        "            loss_components_dict['loss_box'] = loss_items[0]\n",
        "            loss_components_dict['loss_obj'] = loss_items[1]\n",
        "            loss_components_dict['loss_cls'] = loss_items[2]\n",
        "            return loss_components_dict\n",
        "        else:\n",
        "            return self.model(x)\n",
        "\n",
        "#load a pretrained model:\n",
        "#we're using yolov5 due to some compatability issues, but yolo currently has versions up to v11.\n",
        "model = yolov5.load('yolov5s.pt')\n",
        "model = Yolo(model)\n",
        "\n",
        "#Yolo detector settings:\n",
        "detector = PyTorchYolo(model=model,\n",
        "                        device_type='gpu',\n",
        "                        input_shape=(3, 640, 640),\n",
        "                        clip_values=(0, 255),\n",
        "                        attack_losses=(\"loss_total\", \"loss_cls\",\n",
        "                                        \"loss_box\",\n",
        "                                        \"loss_obj\"))"
      ],
      "metadata": {
        "id": "d0BhTkW39XJG"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Adds the patch on top of each image:"
      ],
      "metadata": {
        "id": "em-xCbr77GNg"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "#this adds the patch on top of the images:\n",
        "def addPatch(patch, image_set):\n",
        "  scale = 1.5\n",
        "  patch_np = np.array(patch)    # Convert patches to numpy array:\n",
        "\n",
        "  patched_images = []\n",
        "  for image in image_set:\n",
        "      image_pil = Image.fromarray(image.astype(np.uint8).transpose(1, 2, 0))        # Convert the image from numpy array:\n",
        "\n",
        "      # Get patch dimensions\n",
        "      patch_width, patch_height = patch.size\n",
        "      new_width = int(patch_width * scale)\n",
        "      new_height = int(patch_height * scale)\n",
        "\n",
        "      #upscale patch a bit (for better results)\n",
        "      patch_resized = patch.resize((new_width, new_height), resample=Image.Resampling.BICUBIC)\n",
        "\n",
        "      #Check if the patch has an alpha channel (for transparency)\n",
        "      if patch_resized.mode == 'RGBA':\n",
        "          image_pil.paste(patch_resized, (0,0), mask=patch_resized)\n",
        "      else:\n",
        "          image_pil.paste(patch_resized, (0, 0))   #paste directly on top of image\n",
        "\n",
        "      # Convert the patched image BACK into a numpy array:\n",
        "      patched_image = np.array(image_pil).transpose(2, 0, 1)\n",
        "      patched_images.append(patched_image)\n",
        "\n",
        "  patched_images = np.array(patched_images)\n",
        "  return patched_images"
      ],
      "metadata": {
        "id": "hFg0TeCpSv_3"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Displays the items in a provided image set."
