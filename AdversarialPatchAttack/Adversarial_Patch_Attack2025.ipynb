    {
      "cell_type": "markdown",
      "source": [
        "#Setting up the Attack:"
      ],
      "metadata": {
        "id": "VDyJuwAV_P4k"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "#Yolo parameters\n",
        "NUMBER_CHANNELS = 3\n",
        "INPUT_SHAPE = (NUMBER_CHANNELS, 640, 640)\n",
        "\n",
        "transform = transforms.Compose([\n",
        "        transforms.Resize(INPUT_SHAPE[1], interpolation=transforms.InterpolationMode.BICUBIC),\n",
        "        transforms.CenterCrop(INPUT_SHAPE[1]),\n",
        "        transforms.ToTensor()\n",
        "    ])\n",
        "\n",
        "#these are the images from the imported Google Drive folder.\n",
        "images = ['/content/drive/MyDrive/Adv_Patch/000000454661.jpg', '/content/drive/MyDrive/Adv_Patch/0000000238924.jpg' ,\n",
        "          '/content/drive/MyDrive/Adv_Patch/0000000192342.jpg', '/content/drive/MyDrive/Adv_Patch/0000000341028.jpg',\n",
        "          '/content/drive/MyDrive/Adv_Patch/0000000629184.jpg', '/content/drive/MyDrive/Adv_Patch/0000000100000.jpg']\n",
        "image_set = []\n",
        "\n",
        "#loop through the image files and add to an image numpy array:\n",
        "for img_path in images:\n",
        "    im = Image.open(img_path)\n",
        "    im = transform(im).numpy()\n",
        "    image_set.append(im)\n",
        "image_set = np.array(image_set)*255"
      ],
      "metadata": {
        "id": "kvssj1Vb9XOs"
      },
      "execution_count": null,
      "outputs": []
