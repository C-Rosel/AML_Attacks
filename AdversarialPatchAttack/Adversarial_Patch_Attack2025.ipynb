        "      preds_orig = extract_predictions(dets[i], 0.8)\n",
        "      plot_image_with_boxes(img=images[i].transpose(1,2,0).copy(), boxes=preds_orig[1], pred_cls=preds_orig[0], title=\"Image \" + str(i +1) + \":\")\n",
        "  return dets"
      ],
